{
  "name": "mymemex",
  "version": "0.1.0",
  "description": "A personal evolving memory agent - tracks who you are, what you've done, and what's happening now.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mymemex": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blank3rs/memex.git"
  },
  "homepage": "https://github.com/blank3rs/memex#readme",
  "bugs": {
    "url": "https://github.com/blank3rs/memex/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/cli.ts",
    "start": "node dist/cli.js",
    "watch": "tsc --watch"
  },
  "keywords": [
    "memory",
    "personal",
    "agent",
    "cli",
    "lifelog"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "date-fns": "^4.1.0",
    "inquirer": "^13.2.5",
    "ora": "^9.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
